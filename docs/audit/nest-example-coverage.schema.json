{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortexel.dev/schema/audit/nest-example-coverage.v1.json",
  "title": "Cortexel pinned NEST official-example audit V1",
  "type": "object",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "closedAxis": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "state": { "type": "string" },
        "notes": { "$ref": "#/$defs/notes" }
      },
      "required": ["id", "state", "notes"],
      "additionalProperties": false
    },
    "unsupportedInterface": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "state": { "const": "unsupported" },
        "notes": { "$ref": "#/$defs/notes" }
      },
      "required": ["id", "state", "notes"],
      "additionalProperties": false
    }
  },
  "properties": {
    "registry": { "const": "cortexel-nest-official-example-coverage" },
    "version": { "const": "1.0" },
    "description": { "$ref": "#/$defs/notes" },
    "upstreamAuthority": {
      "type": "object",
      "properties": {
        "project": { "const": "NEST Simulator" },
        "release": { "const": "v3.10" },
        "repository": {
          "const": "https://github.com/nest/nest-simulator.git"
        },
        "commit": {
          "const": "acca9704da248750219a027db99fec6cd1f9052a"
        },
        "rootTreeGitSha1": {
          "const": "7f6f4f0407c4000cded433b86d658191dd82cd79"
        },
        "documentationIndex": {
          "type": "object",
          "properties": {
            "path": { "const": "doc/htmldoc/examples/index.rst" },
            "gitMode": { "const": "100644" },
            "gitBlobSha1": {
              "const": "2965669bd03f128478fa107779485ad5934b73c5"
            }
          },
          "required": ["path", "gitMode", "gitBlobSha1"],
          "additionalProperties": false
        },
        "runner": {
          "type": "object",
          "properties": {
            "path": { "const": "pynest/examples/run_examples.sh" },
            "gitMode": { "const": "100755" },
            "gitBlobSha1": {
              "const": "6b36df9dd356a419e12aa477b0d05611111052f7"
            }
          },
          "required": ["path", "gitMode", "gitBlobSha1"],
          "additionalProperties": false
        },
        "orchestrationCmake": {
          "type": "object",
          "properties": {
            "path": { "const": "pynest/examples/CMakeLists.txt" },
            "gitMode": { "const": "100644" },
            "gitBlobSha1": {
              "const": "b1c834a050be5562edb54218d960fcf255ecd8ea"
            },
            "role": {
              "const": "installs_run_examples_shell_only_not_entrypoint_authority"
            }
          },
          "required": ["path", "gitMode", "gitBlobSha1", "role"],
          "additionalProperties": false
        },
        "exampleTreePath": { "const": "pynest/examples" }
      },
      "required": [
        "project",
        "release",
        "repository",
        "commit",
        "rootTreeGitSha1",
        "documentationIndex",
        "runner",
        "orchestrationCmake",
        "exampleTreePath"
      ],
      "additionalProperties": false
    },
    "sourceInventory": {
      "type": "object",
      "properties": {
        "state": { "const": "complete" },
        "artifact": {
          "type": "object",
          "properties": {
            "path": {
              "const": "docs/audit/nest-example-source-inventory.v1.json"
            },
            "protocol": {
              "const": "cortexel-nest-example-source-inventory"
            },
            "protocolVersion": { "const": 1 },
            "identityAlgorithm": {
              "const": "cortexel-nest-example-source-inventory.rfc8785-sha256.v1"
            },
            "inventoryDigest": {
              "const": "sha256:cd59e82a8eb5af6d482d3042afdf91b0793865aef75843f5b10da6ee61ba3fe6"
            },
            "artifactByteLength": { "const": 196576 },
            "artifactSha256": {
              "const": "sha256:1d762db8c60e174f42371308093c0d091937bde2299ed8cfce4217c9e9179c1a"
            }
          },
          "required": [
            "path",
            "protocol",
            "protocolVersion",
            "identityAlgorithm",
            "inventoryDigest",
            "artifactByteLength",
            "artifactSha256"
          ],
          "additionalProperties": false
        },
        "closure": {
          "type": "object",
          "properties": {
            "pythonSourcePaths": { "const": "complete" },
            "orchestrationAliases": { "const": "complete" },
            "documentationAndRunnerSelectors": { "const": "complete" },
            "canonicalEntrypoints": { "const": "complete" },
            "runnerTargetProfiles": { "const": "complete" },
            "checkedInVisualAssets": { "const": "complete" }
          },
          "required": [
            "pythonSourcePaths",
            "orchestrationAliases",
            "documentationAndRunnerSelectors",
            "canonicalEntrypoints",
            "runnerTargetProfiles",
            "checkedInVisualAssets"
          ],
          "additionalProperties": false
        },
        "counts": {
          "type": "object",
          "properties": {
            "pythonPathEntryCount": { "const": 112 },
            "regularPythonFileCount": { "const": 109 },
            "pythonSymlinkCount": { "const": 3 },
            "canonicalEntrypointCount": { "const": 98 },
            "runnerTargetProfileCount": { "const": 92 },
            "checkedInVisualAssetCount": { "const": 12 }
          },
          "required": [
            "pythonPathEntryCount",
            "regularPythonFileCount",
            "pythonSymlinkCount",
            "canonicalEntrypointCount",
            "runnerTargetProfileCount",
            "checkedInVisualAssetCount"
          ],
          "additionalProperties": false
        },
        "limitations": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/notes" }
        },
        "notes": { "$ref": "#/$defs/notes" }
      },
      "required": [
        "state",
        "artifact",
        "closure",
        "counts",
        "limitations",
        "notes"
      ],
      "additionalProperties": false
    },
    "evidenceAxes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/closedAxis" },
            {
              "type": "object",
              "properties": {
                "id": { "const": "upstream_source_inventory" },
                "state": { "const": "complete" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/closedAxis" },
            {
              "type": "object",
              "properties": {
                "id": { "const": "visual_output_inventory" },
                "state": { "const": "not_generated" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/closedAxis" },
            {
              "type": "object",
              "properties": {
                "id": { "const": "stable_contract_mapping" },
                "state": { "const": "not_assessed" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/closedAxis" },
            {
              "type": "object",
              "properties": {
                "id": { "const": "packaged_adapter_implementation" },
                "state": { "const": "not_assessed" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/closedAxis" },
            {
              "type": "object",
              "properties": {
                "id": { "const": "renderer_coverage" },
                "state": { "const": "not_assessed" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/closedAxis" },
            {
              "type": "object",
              "properties": {
                "id": { "const": "upstream_execution" },
                "state": { "const": "not_run" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/closedAxis" },
            {
              "type": "object",
              "properties": {
                "id": { "const": "scientific_certification" },
                "state": { "const": "not_run" }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "knownUnsupportedInterfaces": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/unsupportedInterface" },
            { "type": "object", "properties": { "id": { "const": "figure_request_v1_connection_adapter" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/unsupportedInterface" },
            { "type": "object", "properties": { "id": { "const": "figure_request_v1_multimeter_adapter" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/unsupportedInterface" },
            { "type": "object", "properties": { "id": { "const": "figure_request_v1_position_adapter" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/unsupportedInterface" },
            { "type": "object", "properties": { "id": { "const": "live_pynest_capture" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/unsupportedInterface" },
            { "type": "object", "properties": { "id": { "const": "spike_recorder_nonmemory_backends" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/unsupportedInterface" },
            { "type": "object", "properties": { "id": { "const": "spike_recorder_step_offset_clock" } } }
          ]
        }
      ],
      "items": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "sourcePathCount": { "const": 112 },
        "canonicalEntrypointCount": { "const": 98 },
        "runnerTargetProfileCount": { "const": 92 },
        "checkedInVisualAssetCount": { "const": 12 },
        "inventoriedVisualOutputCount": { "const": 0 },
        "mappedVisualOutputCount": { "const": 0 },
        "executableVisualOutputCount": { "const": 0 },
        "renderedVisualOutputCount": { "const": 0 },
        "upstreamExecutedVisualOutputCount": { "const": 0 },
        "certifiedVisualOutputCount": { "const": 0 },
        "coverageClaim": { "const": "none" },
        "notes": { "$ref": "#/$defs/notes" }
      },
      "required": [
        "sourcePathCount",
        "canonicalEntrypointCount",
        "runnerTargetProfileCount",
        "checkedInVisualAssetCount",
        "inventoriedVisualOutputCount",
        "mappedVisualOutputCount",
        "executableVisualOutputCount",
        "renderedVisualOutputCount",
        "upstreamExecutedVisualOutputCount",
        "certifiedVisualOutputCount",
        "coverageClaim",
        "notes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "registry",
    "version",
    "description",
    "upstreamAuthority",
    "sourceInventory",
    "evidenceAxes",
    "knownUnsupportedInterfaces",
    "summary"
  ],
  "additionalProperties": false
}
